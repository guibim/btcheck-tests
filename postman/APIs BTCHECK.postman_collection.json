    {
      "name": "Btcheck - News Smoke",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r",
              "pm.test(\"Response time < 2500ms\", () => pm.expect(pm.response.responseTime).to.be.below(2500));\r",
              "pm.test(\"JSON válido\", () => pm.response.to.be.json);\r",
              "\r",
              "const body = pm.response.json();\r",
              "\r",
              "pm.test(\"Schema topo\", () => {\r",
              "  pm.expect(body).to.have.property(\"generated_at\");\r",
              "  pm.expect(body).to.have.property(\"count\");\r",
              "  pm.expect(body).to.have.property(\"items\");\r",
              "  pm.expect(body.items).to.be.an(\"array\");\r",
              "  pm.expect(typeof body.count).to.eql(\"number\");\r",
              "});\r",
              "\r",
              "pm.test(\"count consistente com items.length (quando aplicável)\", () => {\r",
              "  pm.expect(body.items.length).to.eql(body.count);\r",
              "});\r",
              "\r",
              "pm.test(\"Items têm campos obrigatórios\", () => {\r",
              "  body.items.forEach((it, idx) => {\r",
              "    pm.expect(it, `item[${idx}]`).to.have.property(\"id\");\r",
              "    pm.expect(it, `item[${idx}]`).to.have.property(\"source\");\r",
              "    pm.expect(it, `item[${idx}]`).to.have.property(\"title\");\r",
              "    pm.expect(it, `item[${idx}]`).to.have.property(\"url\");\r",
              "\r",
              "    // novo contrato: date-only\r",
              "    pm.expect(it, `item[${idx}]`).to.have.property(\"published_date\");\r",
              "\r",
              "    pm.expect(it.title, `item[${idx}].title`).to.be.a(\"string\").and.not.empty;\r",
              "    pm.expect(it.url, `item[${idx}].url`).to.match(/^https?:\\/\\//);\r",
              "    pm.expect(it.published_date, `item[${idx}].published_date`).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);\r",
              "  });\r",
              "});\r",
              "\r",
              "// Anti-duplicação básica (ids únicos no payload)\r",
              "pm.test(\"IDs únicos no payload\", () => {\r",
              "  const ids = body.items.map(it => it.id);\r",
              "  const uniq = new Set(ids);\r",
              "  pm.expect(uniq.size).to.eql(ids.length);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
