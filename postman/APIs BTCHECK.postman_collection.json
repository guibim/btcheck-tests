    {
      "name": "Price BTC - Coingecko",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r",
              "pm.test(\"JSON válido\", () => pm.response.to.be.json);\r",
              "\r",
              "const body = pm.response.json();\r",
              "\r",
              "pm.test(\"bitcoin.usd e bitcoin.brl existem e são numéricos\", () => {\r",
              "  pm.expect(body).to.have.property(\"bitcoin\");\r",
              "  pm.expect(body.bitcoin).to.have.property(\"usd\");\r",
              "  pm.expect(body.bitcoin).to.have.property(\"brl\");\r",
              "\r",
              "  const usd = Number(body.bitcoin.usd);\r",
              "  const brl = Number(body.bitcoin.brl);\r",
              "\r",
              "  pm.expect(Number.isFinite(usd)).to.eql(true);\r",
              "  pm.expect(Number.isFinite(brl)).to.eql(true);\r",
              "  pm.expect(usd).to.be.greaterThan(0);\r",
              "  pm.expect(brl).to.be.greaterThan(0);\r",
              "});\r",
              "\r",
              "// Soft check: não falha a suite, só loga\r",
              "(() => {\r",
              "  const usd = Number(body?.bitcoin?.usd);\r",
              "  const brl = Number(body?.bitcoin?.brl);\r",
              "  if (Number.isFinite(usd) && Number.isFinite(brl) && brl <= usd) {\r",
              "    console.warn(\"Soft check: BRL <= USD (verificar conversão/cenário atípico).\", { usd, brl });\r",
              "  }\r",
              "})();"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
