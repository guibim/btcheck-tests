    {
      "name": "FNG - Alternative Smoke",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r",
              "pm.test(\"Response time < 2000ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));\r",
              "\r",
              "pm.test(\"JSON válido\", () => pm.response.to.be.json);\r",
              "\r",
              "const body = pm.response.json();\r",
              "\r",
              "pm.test(\"data é array e tem itens\", () => {\r",
              "  pm.expect(body).to.have.property(\"data\");\r",
              "  pm.expect(body.data).to.be.an(\"array\");\r",
              "  pm.expect(body.data.length).to.be.greaterThan(0);\r",
              "});\r",
              "\r",
              "const first = body.data[0] || {};\r",
              "\r",
              "pm.test(\"Campos básicos existem\", () => {\r",
              "  pm.expect(first).to.have.property(\"value\");\r",
              "  pm.expect(first).to.have.property(\"value_classification\");\r",
              "});\r",
              "\r",
              "pm.test(\"value entre 0 e 100\", () => {\r",
              "  const v = Number(first.value);\r",
              "  pm.expect(Number.isFinite(v)).to.eql(true);\r",
              "  pm.expect(v).to.be.at.least(0);\r",
              "  pm.expect(v).to.be.at.most(100);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
